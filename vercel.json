{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/login", "headers": { "Location": "/dashboard" }, "status": 307 },
    { "src": "/app", "headers": { "Location": "/dashboard" }, "status": 307 },
    { "src": "/r/(?<slug>[^/]+)/?$", "dest": "/r.html?slug=$slug" },
    { "src": "/g/(?<slug>[^/]+)/?$", "dest": "/g.html?slug=$slug" },
    { "src": "/dashboard/?$", "dest": "/dashboard.html" },
    { "src": "/privacy/?$", "dest": "/privacy.html" },
    { "src": "/terms/?$", "dest": "/terms.html" },
    { "src": "/for-hosts/?$", "dest": "/for-hosts.html" },
    { "src": "/para-anfitriones/?$", "dest": "/para-anfitriones.html" },
    { "src": "/hosts/?$", "headers": { "Location": "/for-hosts" }, "status": 301 },
    { "src": "/earn/?$", "headers": { "Location": "/for-hosts" }, "status": 301 },
    { "src": "/anfitriones/?$", "headers": { "Location": "/para-anfitriones" }, "status": 301 },
    { "src": "/para-hosts/?$", "headers": { "Location": "/para-anfitriones" }, "status": 301 },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
